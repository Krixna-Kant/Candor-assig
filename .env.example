# Answer writer: any OpenAI-compatible chat endpoint. Leave these blank to use the
# deterministic writer. Retrieval never uses them.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional. Headers are sent only when set. Requests are spaced to stay under the rate.
LLM_HTTP_REFERER=
LLM_X_TITLE=
LLM_REQUESTS_PER_MINUTE=
# 1 asks the endpoint for a JSON object (response_format); replies are parsed leniently either way.
LLM_JSON_MODE=

# OpenRouter example (free models: 20 requests a minute; 50 a day under 10 credits purchased):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#   OPENROUTER_API_KEY=<your OpenRouter key>   (used when LLM_API_KEY is blank)
#   LLM_REQUESTS_PER_MINUTE=15
#   LLM_JSON_MODE=1
# Groq example:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
#   LLM_API_KEY=<your Groq key>
# Gemini example (free tier allows about 20 requests a day per model):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
#   LLM_API_KEY=<your Google AI Studio key>

# CANDOR_WRITER=deterministic   ignore the settings above for one run
# CANDOR_WRITER_STRICT=1        stop on a model error instead of falling back (for scored runs)

# The harness judge (eval_harness/judge.py) reads these, not the ones above.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Set this if the data directory is not ./data
# CANDOR_DATA=
